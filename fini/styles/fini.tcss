/* ═══════════════════════════════════════════════════════════════════════
   TABS - Todos and Logs fill the screen under the header
   ═══════════════════════════════════════════════════════════════════════ */

#tabs {
    height: 1fr;
}

#tabs TabPane {
    height: 1fr;
}

#todos-view,
#logs-view {
    height: 1fr;
    padding: 0 1;
}

.empty {
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   LOGS
   ═══════════════════════════════════════════════════════════════════════ */

#logs-scroll {
    height: 1fr;
    background: transparent;
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
}

#logs-text {
    color: $fg;
}

/* ═══════════════════════════════════════════════════════════════════════
   FOOTER - under every tab: Close on the left, Help or a message on the right
   ═══════════════════════════════════════════════════════════════════════ */

#app-footer {
    dock: bottom;
    height: auto;
    padding: 0 1;
    border-top: solid $gutter;
}

/* Neutral, like the Close button on tui-kit's panels */
#btn-close,
#btn-help {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0;
    border: none;
    padding: 0 2;
    background: $bg-light;
    color: $fg;
}

#btn-close:hover,
#btn-help:hover {
    background: $gutter;
}

/* Help on the right; a message in its place while one shows (FooterMessage), right-aligned over
   the room left of it, an error still on up to three lines */
#btn-help {
    dock: right;
}

FooterMessage {
    width: 1fr;
    margin-left: 2;
    padding: 0;
    text-align: right;
}
