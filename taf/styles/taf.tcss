/* ═══════════════════════════════════════════════════════════════════════
   TABS - each fills the screen under the tabs' row
   ═══════════════════════════════════════════════════════════════════════ */

#tabs {
    height: 1fr;
}

#tabs TabPane {
    height: 1fr;
}

#notes-view,
#todos-view,
#logs-view,
#stats-view,
#watch-view {
    height: 1fr;
    padding: 0 1;
}

.empty {
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   LISTS - Notes, Todos and Watch, like YafYaf's: the search and the dropdowns over the rows
   ═══════════════════════════════════════════════════════════════════════ */

#items-controls,
#stats-controls {
    height: auto;
    background: transparent;
}

#items-list #search {
    width: 1fr;
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

#items-list #search:focus {
    border: solid $blue;
}

/* The dropdowns are boxed like the search field next to them; their overlay opens below */
#items-controls Select,
#stats-controls Select {
    height: 3;
    margin: 0 0 0 2;
}

#stats-controls Select {
    margin: 0 2 0 0;
}

#stats-controls #stats-period {
    width: 20;
}

#stats-controls #stats-action {
    width: 24;
}

#stats-controls #stats-show {
    width: 18;
}

#items-controls #tag-selector {
    width: 30;
}

#items-controls #status-selector {
    width: 14;
}

#items-controls Select SelectCurrent,
#stats-controls Select SelectCurrent {
    background: $bg;
    border: solid $gutter;
    padding: 0 1;
    color: $fg;
}

#items-controls Select:focus SelectCurrent,
#stats-controls Select:focus SelectCurrent {
    border: solid $blue;
}

#items-controls Select SelectOverlay,
#stats-controls Select SelectOverlay {
    background: $bg-dark;
    border: none;
    max-height: 12;
    scrollbar-size: 0 0;
}

#items-controls Select SelectOverlay > .option-list--option-highlighted,
#stats-controls Select SelectOverlay > .option-list--option-highlighted {
    background: $bg-light;
    color: $fg;
    text-style: none;
}

/* The search box is 3 rows with its border; the top margin lines the button up with its text */
#items-controls .tinted {
    margin: 1 0 0 3;
}

#items-status {
    width: 1fr;
    height: 1;
    color: $green;
}

#items-rule {
    height: 1;
    color: $comment;
}

#items-table {
    height: 1fr;
    background: transparent;
    color: $fg;
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
    overflow-x: hidden;
}

#items-table > .datatable--cursor {
    background: $bg-light;
    color: auto;
    text-style: none;
}

#items-table > .datatable--hover {
    background: transparent;
}

#items-list {
    height: 1fr;
}

/* ═══════════════════════════════════════════════════════════════════════
   DETAIL - one note, todo or watch item in place of the list: its header, then its markdown
   ═══════════════════════════════════════════════════════════════════════ */

#item-detail {
    display: none;
    height: 1fr;
}

/* One line, then a blank one before the content: the breadcrumbs' "Todos >", a link back to the
   list as in maison, the id, a watch item's icons, when it was created or updated; on the right the
   box, the star, Edit and Delete */
#item-detail-header {
    height: 1;
    margin-bottom: 1;
    color: $comment;
}

#breadcrumb-list {
    width: auto;
    color: $blue;
}

#breadcrumb-list:hover {
    text-style: underline;
}

.breadcrumb-separator {
    width: auto;
    margin: 0 1;
    color: $comment;
}

#item-detail-id {
    width: auto;
    margin-right: 2;
    color: $fg;
}

#item-detail-date {
    width: auto;
    color: $green;
}

#item-detail-links {
    width: auto;
    margin-right: 2;
}

#item-detail-header .spacer {
    width: 1fr;
}

#item-detail-done {
    width: 3;
}

#item-detail-pin {
    width: 3;
}

#item-detail-pin.-pinned {
    color: $yellow;
}

/* tui-kit's blue and red tinted buttons */
#btn-edit,
#btn-delete {
    margin: 0 0 0 1;
}

#item-detail-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
}

/* Textual's markdown styles use its own theme variables; map them onto the palette, as yafyaf-tui does */
#item-detail-markdown {
    padding: 0;
    color: $fg;
}

/* Link styles do not inherit, so they go on the blocks that hold the text */
#item-detail-markdown MarkdownBlock {
    link-color: $blue;
    link-background: transparent;
    link-style: none;
    link-color-hover: $blue;
    link-background-hover: transparent;
    link-style-hover: underline;
}

#item-detail-markdown MarkdownHeader {
    color: $yellow;
    text-style: bold;
    margin: 1 0 1 0;
}

#item-detail-markdown MarkdownH1 {
    content-align: left middle;
    background: transparent;
    margin: 0 0 1 0;
}

#item-detail-markdown MarkdownBlock > .code_inline {
    background: transparent;
    color: $orange;
}

#item-detail-markdown MarkdownFence {
    background: $bg-dark;
}

#item-detail-markdown MarkdownBlockQuote {
    background: $bg-dark;
    border-left: outer $comment;
}

#item-detail-markdown MarkdownHorizontalRule {
    color: $gutter;
}

/* ═══════════════════════════════════════════════════════════════════════
   LOGS
   ═══════════════════════════════════════════════════════════════════════ */

/* The week in the middle, its dates over its number, between Previous and Next; New Log on the right */
#logs-controls {
    height: 2;
}

#logs-controls .logs-side {
    width: 1fr;
    height: 2;
    align: right top;
}

#logs-week {
    width: auto;
    height: 2;
}

/* "Sep 14 to Sep 20, 2026" is 22 wide at most */
#logs-period {
    width: 26;
    height: 2;
}

#logs-period Static {
    width: 100%;
    height: 1;
    text-align: center;
}

#logs-dates {
    color: $blue;
}

#logs-week-number {
    color: $yellow;
}

#logs-rule {
    height: 1;
    color: $comment;
}

#logs-scroll {
    height: 1fr;
    background: transparent;
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
}

#logs-text {
    color: $fg;
    link-color: $red;
    link-background: transparent;
    link-style: none;
    link-color-hover: $red;
    link-background-hover: transparent;
    link-style-hover: underline;
}

/* ═══════════════════════════════════════════════════════════════════════
   STATS - wider than a narrow terminal: the graph scrolls sideways rather than wrap
   ═══════════════════════════════════════════════════════════════════════ */

#stats-scroll {
    height: 1fr;
    overflow-x: auto;
    background: transparent;
    scrollbar-size: 1 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
}

#stats-text {
    width: auto;
    color: $fg;
    padding: 1 0 0 0;
}

/* ═══════════════════════════════════════════════════════════════════════
   HELP - the keys every tab shares on the left, the tab's own on the right, as in outils
   ═══════════════════════════════════════════════════════════════════════ */

/* As wide as their longest line, but some width each, so a tab with few keys of its own does not
   get a narrow panel: General's own width */
TafHelpScreen .shortcuts-section {
    width: auto;
    min-width: 24;
}

TafHelpScreen #shortcuts-general {
    margin-right: 4;
}

/* ═══════════════════════════════════════════════════════════════════════
   FOOTER - under every tab: Exit, Refresh and Collect on the left, Help or a message on the right
   ═══════════════════════════════════════════════════════════════════════ */

#app-footer {
    dock: bottom;
    height: auto;
    /* The rule and Help's line: Help is docked, so it adds no height of its own */
    min-height: 2;
    padding: 0 1;
    border-top: solid $gutter;
}

/* Neutral, like the Close button on tui-kit's panels. On the right; a message in its place while one
   shows (FooterMessage), right-aligned over the room left of it, an error still on up to three lines */
#btn-help {
    dock: right;
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0;
    border: none;
    padding: 0 2;
    background: $bg-light;
    color: $fg;
}

#btn-help:hover {
    background: $gutter;
}

/* Refresh only on a list, or the logs; Collect and when the last collect ended only on Watch
   (TafApp.refresh_footer) */
#btn-refresh {
    display: none;
    margin: 0 0 0 1;
}

CollectControl {
    display: none;
    width: auto;
    height: 1;
}

#btn-collect {
    margin: 0 0 0 1;
}

#collected-at {
    width: auto;
    height: 1;
    margin: 0 0 0 2;
    color: $comment;
}

FooterMessage {
    width: 1fr;
    margin-left: 2;
    padding: 0;
    text-align: right;
}
